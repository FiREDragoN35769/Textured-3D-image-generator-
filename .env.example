# Optional image provider; importing an existing image needs no API key.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Or run a local Stable Diffusion WebUI with --api and select it in Settings.
SD_WEBUI_URL=
# Workshop-injected Gemini and database variables still work without changes.
# The defaults below are installed by scripts/setup_local_3d.py.
# LOCAL_3D_HOME=.local3d
# STUDIO_DATA_DIR=.data
# MESH_TIMEOUT_SECONDS=1800
